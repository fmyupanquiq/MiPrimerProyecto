# Plantilla del entorno de PRODUCCIÓN (ADR 0021). Copiar a /etc/letfer/letfer.env en el servidor,
# rellenar y proteger:  chown root:letfer /etc/letfer/letfer.env && chmod 0640 /etc/letfer/letfer.env
# NUNCA versionar el archivo relleno ni copiar aquí valores reales. La API valida todo al arrancar
# y se niega a iniciar si falta algo obligatorio (el error nombra la variable, nunca su valor).

NODE_ENV=production
PORT=3000
# Dominio público, el mismo del Caddyfile, con https y sin barra final.
APP_BASE_URL=https://letfer.example.com
# Caddy es el único proxy delante de la API.
TRUST_PROXY_HOPS=1

# --- Secretos ---
# Base de PRODUCCIÓN propia; usuario propio. La API se niega a arrancar en producción si la base se
# llama exactamente letfer_dev, letfer_test o letfer_trial.
DATABASE_URL=postgresql://letfer_app:CAMBIAR@localhost:5432/letfer_prod
# Sin definir esta variable, en producción la IA queda DESACTIVADA y no hace falta clave. Para activar la IA: pon
# AI_TICKETS_ENABLED=true y añade ANTHROPIC_API_KEY=<tu clave> (con true, sin clave la API no arranca).
AI_TICKETS_ENABLED=false
# ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# true solo si el proveedor usa TLS directo (puerto 465); con false se exige STARTTLS.
SMTP_SECURE=false
# Ambas o ninguna. No dejes ninguna variable vacía: una línea "VAR=" cuenta como valor inválido;
# si algo no aplica, borra la línea.
SMTP_USER=
SMTP_PASSWORD=
# Remitente de un dominio verificado en el proveedor de correo.
MAIL_FROM="LetFer <no-reply@letfer.example.com>"

# --- Datos en disco persistente (rutas absolutas obligatorias en producción) ---
TICKETS_DIR=/var/lib/letfer/tickets
BACKUP_DIR=/var/lib/letfer/backups
# Herramientas cliente de PostgreSQL 17 (paquete postgresql-client-17 del repositorio PGDG).
PG_DUMP_PATH=/usr/lib/postgresql/17/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/17/bin/pg_restore
TAR_PATH=/usr/bin/tar

# --- IA (valores por defecto aprobados) ---
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=1
# AI_MAX_ANALYSES_PER_TICKET=5
# AI_MAX_ANALYSES_PER_PROJECT_DAY=50

# Sesiones, bloqueo, límites de tasa, backups (03:00 UTC, 30 generaciones) y mantenimiento
# (04:00 UTC) usan los valores por defecto aprobados (§104, §109.3, §111.6); ver .env.example.
