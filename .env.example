# Copia este archivo a .env y ajusta los valores. NUNCA versiones .env ni
# credenciales reales (spec §41). Este archivo solo documenta las variables.

# --- API ---
PORT=3000

# --- Base de datos (PostgreSQL) ---
# Valores de DESARROLLO LOCAL (npm run db:start). El servidor solo escucha en
# localhost. Producción usará credenciales reales fuera del repositorio.
DATABASE_URL=postgresql://letfer:letfer_dev@localhost:5432/letfer_dev
TEST_DATABASE_URL=postgresql://letfer:letfer_dev@localhost:5432/letfer_test

# Opcionales para scripts/dev-db.mjs (valores por defecto entre paréntesis):
# DB_PORT=5432  DB_USER=letfer  DB_PASSWORD=letfer_dev  DB_NAMES=letfer_dev,letfer_test
