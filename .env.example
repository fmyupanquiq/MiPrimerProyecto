# Copia este archivo a .env y ajusta los valores. NUNCA versiones .env ni
# credenciales reales (spec §41). Este archivo solo documenta las variables.
# La API valida todas las variables al arrancar y falla con un mensaje claro
# (que nombra la variable, nunca su valor) si alguna es inválida.

# --- API ---
PORT=3000
# development | test | production
NODE_ENV=development
# Origen público de la web: enlaces de correo y validación del encabezado Origin.
APP_BASE_URL=http://localhost:5173
# Número de proxys de confianza delante de la API (0 = ninguno).
TRUST_PROXY_HOPS=0
# En producción la cookie de sesión siempre es Secure (HTTPS, spec §41).
# COOKIE_SECURE=false
# Carpeta donde el adaptador de desarrollo escribe los correos (recuperación de contraseña).
MAIL_OUTBOX_DIR=.data/outbox

# --- Base de datos (PostgreSQL) ---
# Valores de DESARROLLO LOCAL (npm run db:start). El servidor solo escucha en
# localhost. Producción usará credenciales reales fuera del repositorio.
DATABASE_URL=postgresql://letfer:letfer_dev@localhost:5432/letfer_dev
TEST_DATABASE_URL=postgresql://letfer:letfer_dev@localhost:5432/letfer_test

# Opcionales para scripts/dev-db.mjs (valores por defecto entre paréntesis):
# DB_PORT=5432  DB_USER=letfer  DB_PASSWORD=letfer_dev  DB_NAMES=letfer_dev,letfer_test

# --- Bootstrap del primer Administrador Global (spec §83) ---
# Solo los lee `npm run bootstrap:admin -w @letfer/api`. Ponlos en tu .env local
# (que no se versiona), ejecuta el comando y luego bórralos del archivo.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=

# --- Parámetros de autenticación (spec §104; valores por defecto aprobados) ---
# SESSION_PERSISTENT_IDLE_SECONDS=2592000      (30 días sin actividad)
# SESSION_PERSISTENT_ABSOLUTE_SECONDS=7776000  (90 días como máximo)
# SESSION_TEMPORARY_IDLE_SECONDS=3600          (1 hora sin actividad)
# SESSION_TEMPORARY_ABSOLUTE_SECONDS=43200     (12 horas como máximo)
# LOCKOUT_MAX_FAILURES=5
# LOCKOUT_WINDOW_SECONDS=900
# LOCKOUT_DURATION_SECONDS=900
# PASSWORD_RESET_TTL_SECONDS=3600
# REAUTH_WINDOW_SECONDS=300
